# 商品视觉工作台 · 国内服务配置
# 在本项目 .env 中填写，仅保存在本机。不要将真实 key 写入此示例文件。
# 默认 Fixture；填写 key 不会自动启用模型或产生费用，真实调用在页面逐次确认。
STUDIO_DATA_DIR=./data

# 图片存储：local 保持本地；oss 将新图片写入私有 OSS，旧本地图片仍兼容。
# 建议新建杭州地域的专用私有 Bucket；共用 Bucket 时使用独立目录及 RAM 权限。
STUDIO_ASSET_BACKEND=local
STUDIO_OSS_BUCKET=""
STUDIO_OSS_REGION=cn-hangzhou
# 服务器在杭州用内网地址；本机调试换成 https://oss-cn-hangzhou.aliyuncs.com
STUDIO_OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
STUDIO_OSS_PREFIX=storm-studio/
STUDIO_OSS_ACCESS_KEY_ID=""
STUDIO_OSS_ACCESS_KEY_SECRET=""
# 使用临时凭据时一并填写 token；过期后需要更新配置并重启服务。
STUDIO_OSS_SECURITY_TOKEN=""

# ① Kimi：把 Moonshot 开放平台 API Key 粘贴在下面的双引号内。
# 控制台：https://platform.moonshot.cn/console/api-keys
# 使用开放平台 API Key，不是 Kimi 网页 Cookie 或 Kimi Code 订阅凭据。
MOONSHOT_API_KEY=""
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# ② Seedream：把火山方舟 API Key 粘贴在下面的双引号内。
# 控制台：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 使用方舟 API Key，不是火山账号的 AccessKey / SecretKey。
ARK_API_KEY=""
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 当前适配的 Seedream 5.0 Pro 型号；账户权限及实时可用性待真实调用验证。
# 不自动退化到其他模型，不支持任意推理接入点 ID。
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# 云端账号配置（放入 runtime.env，由 Compose 注入环境变量）
# 配置并实际验证邮件送达后，才设置为 1；未配置时保持关闭。
STUDIO_REGISTRATION_ENABLED=0
STUDIO_SMTP_HOST=""
STUDIO_SMTP_PORT=465
STUDIO_SMTP_USERNAME=""
STUDIO_SMTP_PASSWORD=""
STUDIO_SMTP_FROM=""
# 全站普通账号合计每日模型调用尝试上限，含文案。主账户不受此上限约束。
STUDIO_PUBLIC_DAILY_CALL_LIMIT=30
