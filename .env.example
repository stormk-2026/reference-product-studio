# 商品视觉工作台 · 国内服务配置
# 在本项目 .env 中填写，仅保存在本机。不要将真实 key 写入此示例文件。
# 默认 Fixture；填写 key 不会自动启用模型或产生费用，真实调用在页面逐次确认。
STUDIO_DATA_DIR=./data

# ① Kimi：把 Moonshot 开放平台 API Key 粘贴在下面的双引号内。
# 控制台：https://platform.moonshot.cn/console/api-keys
# 使用开放平台 API Key，不是 Kimi 网页 Cookie 或 Kimi Code 订阅凭据。
MOONSHOT_API_KEY=""
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# ② Seedream：把火山方舟 API Key 粘贴在下面的双引号内。
# 控制台：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 使用方舟 API Key，不是火山账号的 AccessKey / SecretKey。
ARK_API_KEY=""
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 当前适配的 Seedream 5.0 Pro 型号；账户权限及实时可用性待真实调用验证。
# 不自动退化到其他模型，不支持任意推理接入点 ID。
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
