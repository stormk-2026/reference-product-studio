# Storm Studio only: zones are applied only to this virtual host.
limit_req_zone $binary_remote_addr zone=studio_requests:10m rate=5r/s;
limit_req_zone $server_name zone=studio_global_requests:1m rate=30r/s;
limit_req_zone $binary_remote_addr zone=studio_auth_requests:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=studio_connections:10m;
limit_conn_zone $server_name zone=studio_global_connections:1m;

server {
    listen 80;
    listen [::]:80;
    server_name studio.example.com;
    root /var/www/storm-studio-acme;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://studio.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name studio.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/studio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studio.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;

    # Application login/register protects all data routes.
    # Enable STUDIO_AUTH_ENABLED=1 and bootstrap the owner BEFORE removing old Basic Auth.

    client_max_body_size 16m;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=studio_requests burst=40 nodelay;
    limit_req zone=studio_global_requests burst=60 nodelay;
    limit_conn studio_connections 40;
    limit_conn studio_global_connections 80;

    location ^~ /api/auth/ {
        client_max_body_size 8k;
        limit_req zone=studio_auth_requests burst=5 nodelay;
        limit_req zone=studio_global_requests burst=10 nodelay;
        proxy_pass http://127.0.0.1:18765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    error_page 429 = @studio_rate_limit;
    location @studio_rate_limit {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"detail":"操作过于频繁，请稍后再试"}';
    }


    location / {
        proxy_pass http://127.0.0.1:18765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}
